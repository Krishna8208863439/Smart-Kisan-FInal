# ─────────────────────────────────────────────────────────────────────────────
# Smart Kisan API — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/smart_kisan
# Docker:    mongodb://admin:smartkisan2024@mongodb:27017/smart_kisan?authSource=admin
# Atlas:     mongodb+srv://<user>:<pass>@cluster.mongodb.net/smart_kisan
MONGODB_URI=mongodb://localhost:27017/smart_kisan

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Docker: redis://:sk_redis_pass@redis:6379
# Leave empty to use in-memory fallback (non-persistent)
REDIS_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_64_BYTE_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Twilio (Phone OTP) ────────────────────────────────────────────────────────
# Get from: https://console.twilio.com
# Leave empty to use demo OTP mode (code shown in response)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Firebase (FCM Push Notifications) ────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── API Base URL (for Swagger docs server section) ────────────────────────────
API_BASE_URL=http://localhost:5000
